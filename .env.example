# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Webhooks / Products)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Resend (Domains + API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog (Project Settings)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Cron auth — Vercel automatically sends this as `Authorization: Bearer <value>`
# to paths listed in vercel.json when this var is set in the project's env vars.
CRON_SECRET=

# Base URL of this deployment (used for links in transactional emails).
NEXT_PUBLIC_SITE_URL=
