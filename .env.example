# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Webhooks / Products)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Resend (Domains + API Keys)
RESEND_API_KEY=
# Must be an address on a domain verified at resend.com/domains, e.g.
# "AIRfasting <noreply@airfasting.com>". Resend's sandbox sender, onboarding@resend.dev,
# is only allowed to mail the Resend account owner's own address and returns 403 for
# everybody else — which leaves no trace in Resend's email log, because a refused request
# never becomes one. Production ran on the sandbox sender from 29 Aug to 30 Sep 2026 and
# silently sent nothing.
RESEND_FROM_EMAIL=

# Where the daily billing reconciliation report goes when it finds a mismatch. Unset means
# the findings are logged but nobody is told.
ADMIN_EMAIL=

# PostHog (Project Settings)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Cron auth — Vercel automatically sends this as `Authorization: Bearer <value>`
# to paths listed in vercel.json when this var is set in the project's env vars.
CRON_SECRET=

# Base URL of this deployment (used for links in transactional emails).
NEXT_PUBLIC_SITE_URL=
